# Core runtime configuration
NODE_ENV=development

# JSON array of API key records:
# [{"keyId":"desktop-prod","keyHash":"<sha256 hex>","applicationId":"desktop-app","enabled":true,"allowedRepositories":["acme/product-feedback"]}]
FEEDBACK_API_KEYS_JSON=[]

# JSON array of repository records:
# [{"name":"acme/product-feedback","installationId":123456,"enabled":true,"defaultLabels":["feedback"],"labelsByType":{"bug_report":["bug"],"feature_request":["enhancement"]}}]
FEEDBACK_REPOSITORIES_JSON=[]

# Rate limiting + spam controls
RATE_LIMIT_BACKEND=upstash
RATE_LIMIT_API_KEY_WINDOW_SECONDS=60
RATE_LIMIT_API_KEY_MAX_REQUESTS=20
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_IP_MAX_REQUESTS=60
SPAM_DEDUPE_WINDOW_SECONDS=300
SPAM_MAX_URLS=6

# Attachment validation
ALLOW_ZIP_ATTACHMENTS=false

# Attachment storage backend (vercel_blob | mock)
ATTACHMENT_STORAGE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=
BLOB_KEY_PREFIX=feedback-intake

# Upstash Redis for stateless rate limiting/dedupe
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub App credentials
GITHUB_APP_ID=
# Keep multiline private key escaped with \n when stored in env var
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_BASE_URL=https://api.github.com

# Test-only switch for mocked GitHub interactions
GITHUB_MOCK_ENABLED=false
